KAFKA_BROKERS=kafka:9093
REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_ORIGINAL_TOPICS=orders,payments

MAX_RETRIES=3
RETRY_DELAYS_MS=60000,300000,600000
DLQ_SUFFIX=.dlq

# Test switch: set to "true" to force processing failures
# so the retry/DLQ flow can be exercised.
ORDER_PROCESSOR_SHOULD_FAIL=false

# How often (ms) RetryScheduler polls Redis for due jobs.
RETRY_SCHEDULER_INTERVAL_MS=1000

# Identifies this process in structured logs. Optional: defaults to the
# container/host name when unset, which is already unique per instance.
# INSTANCE_ID=
